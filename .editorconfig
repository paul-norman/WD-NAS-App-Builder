# Top-most EditorConfig file
root = true

# Global rules
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# WD's apkg.rc files need tabs
[*.rc]
indent_style = tab

# Yaml files are fussy
[*.{yaml,yml}]
indent_size = 2
