# Pi-hole's settings - setup.sh copies this to /mnt/HD/HD_a2/Nas_Prog/_pihole/.env (asking for the web password)

# The web interface's password (http://<nas-ip>:8053/admin)
WEB_PASSWORD=change-me

# Upstream DNS servers Pi-hole asks for what it doesn't block, separated by ; - e.g. Cloudflare 1.1.1.1;1.0.0.1, Quad9
# 9.9.9.9;149.112.112.112, Google 8.8.8.8;8.8.4.4. They can also be changed later in Pi-hole (Settings -> DNS)
UPSTREAMS=1.1.1.1;1.0.0.1

# The time zone (a TZ identifier: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones#List)
TZ=Europe/London

# The values below this line do not need to be changed
###################################################################################
CONFIG_LOCATION=/mnt/HD/HD_a2/Nas_Prog/_pihole/etc-pihole
