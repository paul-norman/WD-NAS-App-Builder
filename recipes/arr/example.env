# The Arr stack's settings - setup.sh copies this to /mnt/HD/HD_a2/Nas_Prog/_arr/.env (generating the password and the API
# keys the first time). Run setup.sh again after changing anything here: it applies it to every app

# Downloads and the library: a folder on a share. It gets torrents/ and usenet/ (downloads) and media/ (the library: tv,
# movies, music, books) - point Jellyfin or Plex at media/
DATA_ROOT=/mnt/HD/HD_a2/Media

# The user name and password for every app's web interface (qBittorrent, Prowlarr, Sonarr, Radarr, Bazarr...)
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# Optional apps (on or off): music, books, Usenet downloads (needs a provider's account), Cloudflare-protected indexers
LIDARR=off
BOOKS=off
SABNZBD=off
FLARESOLVERR=off

# The media server told about each new file (none, plex, jellyfin or emby), its key (Jellyfin or Emby: an API key from its
# dashboard; Plex: its token - empty, read from Plex on the NAS) and its address (empty: on the NAS, at its usual port)
MEDIA_SERVER=none
MEDIA_SERVER_KEY=
MEDIA_SERVER_URL=

# The ntfy topic the apps send notifications to (with the ntfy app on the NAS - its token is read from it), empty for none
NTFY_TOPIC=arr

# Quality rules (on or off): the TRaSH Guides' profiles in Sonarr and Radarr, kept up to date by Recyclarr - and the one
# Seerr requests with (1080p or 2160p)
RECYCLARR=on
QUALITY=1080p

# Bazarr's subtitle language (a two-letter code, e.g. en, fr, de) - used when it's first set up
SUBTITLE_LANGUAGE=en

# qBittorrent's port for incoming connections (forwarding it on the router helps, but isn't needed)
TORRENT_PORT=6881

# The time zone (a TZ identifier: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones#List)
TZ=Europe/London

# The values below this line do not need to be changed
###################################################################################
# The apps' API keys (setup.sh generates them): how they reach each other
PROWLARR_API_KEY=
SONARR_API_KEY=
RADARR_API_KEY=
LIDARR_API_KEY=
BOOKSHELF_API_KEY=
# The apps' settings folders, the optional apps' profile, and the user and group the apps run as (84, and the NAS's
# share group)
CONFIG_ROOT=/mnt/HD/HD_a2/Nas_Prog/_arr
COMPOSE_PROFILES=on
PUID=84
PGID=1000
