# Frigate's settings - setup.sh copies this to /mnt/HD/HD_a2/Nas_Prog/_frigate/.env (with a generated admin password)

# The recordings, clips and snapshots: a folder on a share (setup.sh creates it), so they can also be copied off over SMB
RECORDINGS=/mnt/HD/HD_a2/Cameras/Frigate

# Object detection: cpu (the NAS's processor - 1-2 cameras), coral (a Coral USB accelerator plugged into the NAS),
# remote (another machine on the network, running remote-detector/ - its address and port in REMOTE_DETECTOR, e.g.
# 192.168.1.50:5555) or manual (the detectors and model sections of Frigate's config.yml are left as you set them).
# Changed? Run setup.sh again
DETECTOR=cpu
REMOTE_DETECTOR=

# The admin user's password (user: admin) - only set on a new install; after that, change it in Frigate (Settings ->
# Users). setup.sh generates one
ADMIN_PASSWORD=change-me

# The time zone (a TZ identifier: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones#List)
TZ=Europe/London

# The Frigate release (a remote detector should run the same one)
FRIGATE_VERSION=0.18.2

# The values below this line do not need to be changed
###################################################################################
CONFIG_LOCATION=/mnt/HD/HD_a2/Nas_Prog/_frigate/config
