# Linkwarden's settings - setup.sh copies this to /mnt/HD/HD_a2/Nas_Prog/_linkwarden/.env (with generated secrets and the
# admin password it asks for). Linkwarden's own options: https://docs.linkwarden.app/self-hosting/environment-variables
# (an option of Linkwarden's goes into compose.yaml's environment list for the linkwarden service, not just here)

# The admin account the install makes (only on a new install: afterwards, change it in Linkwarden)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Linkwarden's version (updated with: docker compose pull && docker compose up -d)
LINKWARDEN_VERSION=v2.17.0

# Generated by setup.sh: letters and digits only
POSTGRES_PASSWORD=change-me
NEXTAUTH_SECRET=change-me
MEILI_MASTER_KEY=change-me

# The values below this line do not need to be changed
###################################################################################
DATA_LOCATION=/mnt/HD/HD_a2/Nas_Prog/_linkwarden/data
PG_LOCATION=/mnt/HD/HD_a2/Nas_Prog/_linkwarden/pgdata
MEILI_LOCATION=/mnt/HD/HD_a2/Nas_Prog/_linkwarden/meili_data
