# Immich's settings - setup.sh copies this to /mnt/HD/HD_a2/Nas_Prog/_immich/.env (with a generated DB_PASSWORD). All the
# supported variables: https://docs.immich.app/install/environment-variables

# The photos and videos: a folder on a share (setup.sh creates it), so that the originals can also be reached over SMB
UPLOAD_LOCATION=/mnt/HD/HD_a2/Photos/Immich

# Existing photo folders for Immich to show as well (optional), read only: Immich never changes anything in them. Several
# are separated by |, e.g. /mnt/HD/HD_a2/Paul/Photos|/mnt/HD/HD_a2/Jane/Photos. Each appears inside Immich as /external
# followed by its path on the NAS (e.g. /external/Paul/Photos): add them in Administration -> External Libraries
EXTERNAL_PHOTOS=

# The database and the machine learning models: on the NAS's own volume, next to the apps (kept across app reinstalls)
DB_DATA_LOCATION=/mnt/HD/HD_a2/Nas_Prog/_immich/postgres
MODEL_CACHE_LOCATION=/mnt/HD/HD_a2/Nas_Prog/_immich/model-cache

# The time zone (a TZ identifier: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones#List)
TZ=Europe/London

# The Immich version: v3 follows Immich's 3.x releases (updated with: docker compose pull && docker compose up -d)
IMMICH_VERSION=v3

# Face recognition (detecting and grouping people) on a NEW install: off by default here, as it's the heaviest of Immich's
# machine learning on the NAS's CPU. Only applied by setup.sh before Immich's admin user exists - after that, it's
# Immich's own setting (Administration -> Settings -> Machine Learning Settings -> Facial Recognition)
FACIAL_RECOGNITION=off

# The database password: letters and digits only (setup.sh generates one)
DB_PASSWORD=change-me

# The values below this line do not need to be changed
###################################################################################
DB_USERNAME=postgres
DB_DATABASE_NAME=immich
