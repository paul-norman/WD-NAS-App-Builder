[
    {
        "name":     "Example: copy a share to a USB drive",
        "file":     "usb_copy.sh",
        "trigger":  "schedule",
        "schedule": "30 2 * * *",
        "timeout":  "360",
        "notify":   "failed"
    },
    {
        "name":     "Example: warn when a volume is nearly full",
